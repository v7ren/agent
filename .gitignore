# dependencies
node_modules/
pet/node_modules/

# env / secrets
.env
.env.*
!.env.example

# process / logs
*.log
*.pid
.fishd.pid

# editor / OS
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
