# provider: opencode (Go) | deepseek | stub  (empty = auto)
FISHD_PROVIDER=opencode
# opencode-go models:
#   mimo-v2.6-flash      cheap, answers directly            <- default
#   deepseek-v4.1-flash  reasons first, needs max_tokens >= 600
FISHD_MODEL=mimo-v2.6-flash
FISHD_MAX_TOKENS=600
# DeepSeek thinking: on | off (empty = server default, which is on)
# thinking tokens count against FISHD_MAX_TOKENS, so 2000+ is safer
FISHD_REASONING=
# Big window: the chat grows to this many tokens, then its oldest part is
# compacted into a note linked to the journal, diary and people notes. The
# newest FISHD_COMPACT_KEEP of the window stays word for word. Her recent chat
# is saved to disk and comes back after a restart. "off" = the old 24-turn window.
FISHD_CONTEXT_TOKENS=100000
FISHD_COMPACT_KEEP=0.3
# low | high | max (empty = server default)
FISHD_REASONING_EFFORT=
# leave empty to reuse the key opencode already stored via /connect
OPENCODE_API_KEY=

DEEPSEEK_API_KEY=

# discord
DISCORD_TOKEN=
# channel ids where she answers every message without being mentioned
DISCORD_CHANNEL_IDS=
# optional: only serve these guilds
DISCORD_GUILD_IDS=
# 1 = answer every message in every allowed guild channel
DISCORD_REPLY_ALL=0
# 1 = let her decide when to join an unaddressed conversation
DISCORD_AMBIENT=1
# base chance for the heuristic gate
DISCORD_AMBIENT_P=0.12
# being called by name always gets a reply
DISCORD_NAMES=大肥魚,肥魚

# ---- decision gate -------------------------------------------------
# heuristic | jev | llm | chain
#   chain = jev -> openrouter models -> main provider -> heuristic
FISHD_GATE=chain

# System One: returns P(speak) instead of a word. Free, ~700ms.
JEV_MODEL=jev-1.13-free
JEV_THRESHOLD=0.32
JEV_TIMEOUT_MS=4000
# a line plainly for someone else (@ another person, no call for her): Jev's
# threshold is multiplied by this. 1 = no special treatment, bigger = quieter
JEV_AIMED_BIAS=2.5
# JEV_API_KEY=            (falls back to the opencode key)

# Extra brain for the gate, tried in order, first success wins.
# Needs a working OpenRouter (or any OpenAI-compatible) key.
GATE_BASE_URL=https://openrouter.ai/api/v1
GATE_API_KEY=
GATE_MODELS=liquid/lfm-2.5-2.6b:free
GATE_MAX_TOKENS=200
GATE_TIMEOUT_MS=8000
GATE_MAX_PER_MIN=6

# web
FISHD_PORT=7777

# who may reach her
DISCORD_DMS=1
DISCORD_DM_USERS=
DISCORD_ONLY_CHANNELS=
DISCORD_IGNORE_USERS=

# 1 = default, 2 = twice as likely to chime in, 0.5 = quieter
DISCORD_TALK=1

# she starts a topic by herself, into a quiet channel
DISCORD_SPONTANEOUS=0
DISCORD_SPON_CHANNELS=
DISCORD_SPON_MIN=90
DISCORD_SPON_MAX=240
DISCORD_SPON_QUIET=20

# burst model: read the conversation, not the last line
DISCORD_BURST_MIN=10
DISCORD_ARM_MS=3000
DISCORD_SETTLE_MIN=3
DISCORD_BUDGET=4/30

# owner: closer, chattier, may receive DMs she starts
DISCORD_OWNER_IDS=
DISCORD_SPON_DM=1

# persona pack: empty = built-in vault/persona
FISHD_PACK=
# gifs / short videos she may send; empty = vault/share
FISHD_SHARE_DIR=

# voice: 1 = sometimes speak a reply aloud in the pet/web client
FISHD_VOICE=1
FISHD_VOICE_P=0.5
FISHD_VOICE_MAX=60

# dsh-pet agent link: JSONL state bus (thinking/working/idle/error)
# empty = vault/state/pet-events.jsonl; 0 = disabled
FISHD_PET_EVENTS=
FISHD_PET=1

# spontaneous timing per target
DISCORD_SPON_DM_MIN=60
DISCORD_SPON_DM_MAX=180
DISCORD_SPON_HUSH=1-6
